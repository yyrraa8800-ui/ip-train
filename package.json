{
  "name": "infinite-ip",
  "version": "1.0.0",
  "description": "Infinite — a hypertrophy training app built on the IP Method. Self-contained web app (PWA) that runs in Koder, Safari, or as an Add-to-Home-Screen icon. No Mac, no App Store, no fees.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:seed": "node scripts/buildSeed.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
